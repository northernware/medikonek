# Any PostgreSQL connection string. `npm run db:start` spins up a local one and
# prints this exact URL; a hosted one (Prisma Postgres, Neon, Supabase, RDS)
# drops in unchanged — apply the schema to it with `npm run db:deploy`.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"

# Scratch database `prisma migrate dev` replays migrations into. It must point at
# a different instance from DATABASE_URL — `npm run db:start` provides one on the
# next port. A hosted database usually has no second instance to spare, so new
# migrations are authored locally and then applied with `npm run db:deploy`,
# which needs no shadow database.
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable"

# Signing key for the session cookie — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""
