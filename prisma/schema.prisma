// MEDIKONEK — clinical records for family practice.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A doctor account. Every household, appointment and record is scoped to one.
model Doctor {
  id            String  @id @default(cuid())
  email         String  @unique
  passwordHash  String
  fullName      String
  specialty     String?
  licenseNumber String?
  clinicName    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  households     Household[]
  appointments   Appointment[]
  medicalRecords MedicalRecord[]
}

/// A household. Patients are grouped under one so shared history — address,
/// hereditary conditions, an outbreak running through the house — stays visible.
/// Each member still keeps their own separate record, appointments and history;
/// the grouping is for finding relatives, shared contact details, and hereditary
/// risk, not for merging charts.
model Household {
  id       String @id @default(cuid())
  doctorId String
  doctor   Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  name          String // e.g. "Dela Cruz"
  address       String?
  contactNumber String?
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patients Patient[]

  @@unique([doctorId, name])
  @@index([doctorId])
}

enum Relationship {
  HEAD
  SPOUSE
  CHILD
  PARENT
  SIBLING
  GRANDPARENT
  OTHER
}

enum Sex {
  MALE
  FEMALE
}

enum BloodType {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
  UNKNOWN
}

model Patient {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  firstName  String
  middleName String?
  lastName   String

  dateOfBirth  DateTime     @db.Date
  sex          Sex
  relationship Relationship @default(OTHER)
  bloodType    BloodType    @default(UNKNOWN)

  /// Whether the list below has been taken, is known to be empty, or was never
  /// asked. "No known allergies" and "not asked yet" are different facts, and a
  /// bare empty list cannot tell them apart.
  allergyStatus   ClinicalListStatus @default(UNKNOWN)
  conditionStatus ClinicalListStatus @default(UNKNOWN)

  contactNumber String?
  email         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments   Appointment[]
  medicalRecords MedicalRecord[]
  allergies      PatientAllergy[]
  conditions     PatientCondition[]

  @@index([householdId])
  @@index([lastName, firstName])
}

/// Whether a clinical list has been taken at all.
enum ClinicalListStatus {
  /// The list below is what the patient reported.
  RECORDED
  /// Asked, and there are none.
  NONE_KNOWN
  /// Not asked yet — the default, so nothing reads as "safe" by omission.
  UNKNOWN
}

enum AllergySeverity {
  MILD
  MODERATE
  SEVERE
}

/// One allergy. `label` is free text so a doctor is never blocked by the
/// catalogue; the picker offers the common ones and accepts anything else.
model PatientAllergy {
  id        String  @id @default(cuid())
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  label    String
  reaction String?
  severity AllergySeverity?
  notes    String?

  createdAt DateTime @default(now())

  @@unique([patientId, label])
  @@index([patientId])
}

model PatientCondition {
  id        String  @id @default(cuid())
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  label String
  notes String?

  createdAt DateTime @default(now())

  @@unique([patientId, label])
  @@index([patientId])
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentType {
  IN_PERSON
  TELECONSULTATION
  HOME_VISIT
}

enum VisitPriority {
  ROUTINE
  URGENT
  FOLLOW_UP
}

/// Where the booking came from. Only STAFF and WALK_IN are reachable today;
/// PATIENT_PORTAL is here for when patients can book themselves.
enum BookingSource {
  STAFF
  WALK_IN
  PHONE
  PATIENT_PORTAL
}

/// Recorded preference only — nothing sends reminders yet.
enum ReminderPreference {
  NONE
  SMS
  EMAIL
  APP
}

/// What the visit is for. A controlled list so the schedule can be read at a
/// glance and reported on later; the free-text `reason` carries the specifics.
enum ServiceType {
  GENERAL_CONSULTATION
  FAMILY_CHECKUP
  FOLLOW_UP_CHECKUP
  ROUTINE_PHYSICAL_EXAM
  PEDIATRIC_CONSULTATION
  SENIOR_CITIZEN_CONSULTATION
  PRENATAL_POSTNATAL_CONSULTATION
  CHRONIC_DISEASE_MANAGEMENT
  PRESCRIPTION_RENEWAL
  LABORATORY_RESULT_REVIEW
  MEDICAL_CERTIFICATE_REQUEST
  VACCINATION_CONSULTATION
  MINOR_INJURY_WOUND_CARE
  TELECONSULTATION
  REFERRAL_CONSULTATION
}

model Appointment {
  id        String  @id @default(cuid())
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId  String
  doctor    Doctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  scheduledAt     DateTime
  durationMinutes Int               @default(30)
  service         ServiceType       @default(GENERAL_CONSULTATION)
  reason          String
  status          AppointmentStatus @default(PENDING)
  type            AppointmentType   @default(IN_PERSON)
  priority        VisitPriority     @default(ROUTINE)

  /// Visible to the patient if they are ever shown their booking.
  notes String?

  // --- Staff-only ---
  source             BookingSource      @default(STAFF)
  reminderPreference ReminderPreference @default(NONE)
  room               String?
  internalNotes      String?

  /// The visit this one follows on from, so a follow-up chain is navigable.
  previousAppointmentId String?
  previousAppointment   Appointment?  @relation("FollowUpChain", fields: [previousAppointmentId], references: [id], onDelete: SetNull)
  followUps             Appointment[] @relation("FollowUpChain")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Filled in when the visit is documented.
  medicalRecord MedicalRecord?

  @@index([doctorId, scheduledAt])
  @@index([patientId])
  @@index([previousAppointmentId])
}

/// One encounter: what was complained of, what was measured, what was decided.
model MedicalRecord {
  id        String  @id @default(cuid())
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId  String
  doctor    Doctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  /// Set when the encounter came from a booked appointment.
  appointmentId String?      @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  visitDate DateTime @default(now())

  chiefComplaint          String
  historyOfPresentIllness String?

  // Vitals — all optional; a doctor records what they took.
  temperatureC     Float?
  heartRate        Int?
  respiratoryRate  Int?
  systolic         Int?
  diastolic        Int?
  weightKg         Float?
  heightCm         Float?
  oxygenSaturation Int?

  assessment    String?
  treatmentPlan String?
  followUpDate  DateTime? @db.Date
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prescriptions Prescription[]

  @@index([patientId, visitDate])
  @@index([doctorId])
}

model Prescription {
  id              String        @id @default(cuid())
  medicalRecordId String
  medicalRecord   MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)

  drugName     String
  dosage       String
  frequency    String
  duration     String?
  instructions String?

  createdAt DateTime @default(now())

  @@index([medicalRecordId])
}
